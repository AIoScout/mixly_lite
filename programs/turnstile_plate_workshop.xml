<xml xmlns="https://developers.google.com/blockly/xml">
  <!--
    Licence-plate gate controller (S3 on the gate) — listens to the AI Eye
    (P4, plate firmware) over UART. Three confirmed frames of a registered
    plate open the servo gate for 3 s, then it closes. Wire the gate servo
    to the S3 GPIO pin set below (default 4) and the P4 UART as usual
    (P4 TX11 → S3 RX44, P4 RX10 ← S3 TX43, GND).
  -->
  <variables></variables>
  <block type="base_setup" x="0" y="0">
    <statement name="DO">
      <block type="serial_begin">
        <field name="serial_select">Serial</field>
        <value name="CONTENT"><shadow type="math_number"><field name="NUM">115200</field></shadow></value>
        <next>
          <block type="smartcar_p4_plate_start_link">
            <next>
              <block type="smartcar_servo_set">
                <value name="PIN"><shadow type="math_number"><field name="NUM">4</field></shadow></value>
                <value name="ANGLE"><shadow type="math_number"><field name="NUM">0</field></shadow></value>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="smartcar_p4_plate_update" x="0" y="300">
    <next>
      <block type="controls_if">
        <value name="IF0">
          <block type="smartcar_p4_plate_ready"></block>
        </value>
        <statement name="DO0">
          <block type="serial_println">
            <field name="serial_select">Serial</field>
            <field name="new_line">println</field>
            <value name="CONTENT">
              <block type="smartcar_p4_plate_latest_index"></block>
            </value>
            <next>
              <block type="smartcar_servo_set">
                <value name="PIN"><shadow type="math_number"><field name="NUM">4</field></shadow></value>
                <value name="ANGLE"><shadow type="math_number"><field name="NUM">90</field></shadow></value>
                <next>
                  <block type="controls_delay">
                    <field name="UNIT">millis</field>
                    <value name="DELAY_TIME"><shadow type="math_number"><field name="NUM">3000</field></shadow></value>
                    <next>
                      <block type="smartcar_servo_set">
                        <value name="PIN"><shadow type="math_number"><field name="NUM">4</field></shadow></value>
                        <value name="ANGLE"><shadow type="math_number"><field name="NUM">0</field></shadow></value>
                        <next>
                          <block type="smartcar_p4_plate_action_done"></block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </next>
  </block>
</xml>
