<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Turnstile car — line tracking with ultrasonic obstacle stop/resume and
       a right-turn bypass when the obstacle stays. RFID tags are reported. -->
  <variables></variables>
  <block type="base_setup" x="0" y="0">
    <statement name="DO">
      <block type="serial_begin">
        <field name="serial_select">Serial</field>
        <value name="CONTENT"><shadow type="math_number"><field name="NUM">115200</field></shadow></value>
        <next>
          <block type="smartcar_set_pid_gains">
            <value name="KP"><shadow type="math_number"><field name="NUM">3.07</field></shadow></value>
            <value name="KI"><shadow type="math_number"><field name="NUM">0</field></shadow></value>
            <value name="KD"><shadow type="math_number"><field name="NUM">0</field></shadow></value>
            <next>
              <block type="smartcar_set_target_rpm">
                <value name="TARGET"><shadow type="math_number"><field name="NUM">300</field></shadow></value>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="smartcar_follow_line_until_stop" x="0" y="240">
    <field name="TRIGGER">ultrasonic</field>
    <value name="DIST"><shadow type="math_number"><field name="NUM">10</field></shadow></value>
    <next>
      <block type="smartcar_rfid_report_new_tag">
        <next>
          <block type="smartcar_obstacle_wait_clear">
            <value name="RESUME_CM"><shadow type="math_number"><field name="NUM">11</field></shadow></value>
            <value name="TIMEOUT_S"><shadow type="math_number"><field name="NUM">10</field></shadow></value>
            <next>
              <block type="controls_if">
                <value name="IF0">
                  <block type="logic_compare">
                    <field name="OP">LT</field>
                    <value name="A"><block type="smartcar_get_distance_cm"></block></value>
                    <value name="B"><shadow type="math_number"><field name="NUM">10</field></shadow></value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="smartcar_rotate_right">
                    <next>
                      <block type="smartcar_wait_until_centered"></block>
                    </next>
                  </block>
                </statement>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
