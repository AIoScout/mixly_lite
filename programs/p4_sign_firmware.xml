<xml xmlns="https://developers.google.com/blockly/xml">
  <!--
    AI Eye firmware (P4) — Compile & Upload build and flash the exported
    TFLite_Sign sketch (camera + trained model) to the AI Eye board.
    Flow: train a sign/plate project in AI Training, Export, then select
    the AI Eye board's serial port below and press Compile, then Upload.
    The S3 car runs its own block program (P4 link blocks).
  -->
  <variables></variables>
  <block type="base_setup" x="0" y="0">
    <statement name="DO">
      <block type="aivision_sign_firmware_deploy"></block>
    </statement>
  </block>
</xml>
